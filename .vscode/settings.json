{
    "deno.enable": true,
    "deno.enablePaths": [
        "supabase/functions"
    ],
    "deno.lint": true,
    "deno.unstable": true,
    "deno.importMap": "supabase/import_map.json",
    "deno.suggest.imports.hosts": {
        "https://deno.land": true,
        "https://esm.sh": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "denoland.vscode-deno"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    }
}